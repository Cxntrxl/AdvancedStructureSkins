                DestinationFolder="$(ModsDirectory)"
        />
        <Copy
                SourceFiles="$(TargetPath)"
                DestinationFolder="$(MSBuildProjectDirectory)\..\!ThunderstoreBuilds\$(ModName)\Mods"
        />
    </Target>
